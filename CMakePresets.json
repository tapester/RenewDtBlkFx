
{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-ninja-release",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/modules/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 - Ninja Release (static FFTW)",
      "inherits": "base-ninja-release",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "BUILD_TESTING": "OFF",
        "DTBLKFX_BUILD_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "windows-x64-tests",
      "displayName": "Windows x64 - Ninja Release with tests",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/windows-x64-tests",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64-dynamic-fftw",
      "displayName": "Windows x64 - Ninja Release (dynamic FFTW)",
      "inherits": "base-ninja-release",
      "binaryDir": "${sourceDir}/build/windows-x64-dynamic-fftw",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "BUILD_TESTING": "OFF",
        "DTBLKFX_BUILD_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon - Ninja Release",
      "inherits": "base-ninja-release",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "BUILD_TESTING": "OFF",
        "DTBLKFX_BUILD_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "macos-arm64-tests",
      "displayName": "macOS Apple Silicon - Ninja Release with tests",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/macos-arm64-tests",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64"
    },
    {
      "name": "windows-x64-tests",
      "configurePreset": "windows-x64-tests"
    },
    {
      "name": "windows-x64-dynamic-fftw",
      "configurePreset": "windows-x64-dynamic-fftw"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-arm64-tests",
      "configurePreset": "macos-arm64-tests"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-tests",
      "configurePreset": "windows-x64-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "macos-arm64-tests",
      "configurePreset": "macos-arm64-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    }
  ]
}
